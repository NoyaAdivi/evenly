{
  "name": "evenly",
  "version": "4.0.0",
  "description": "Split any bill every way: receipt scanning, per dish, food & drinks, group links, hotel nights, trip expenses. Node.js API with Docker and GitHub Actions CI/CD",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "node --check src/*.js test/*.js",
    "test": "node --test --experimental-test-coverage test/*.test.js"
  },
  "engines": { "node": ">=20" },
  "author": "Noya Adivi",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/NoyaAdivi/evenly.git" },
  "dependencies": { "express": "^4.21.2" }
}
